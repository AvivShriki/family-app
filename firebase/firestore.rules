// חוקי האבטחה של Firestore. מתפרסמים עם:
//   firebase deploy --only firestore:rules
//
// העיקרון: כל משפחה חיה בתוך households/{householdId}, והשיוך של משתמש
// למשק בית נקבע במסמך users/{uid}. משתמש יכול לגעת אך ורק בנתונים של
// משק הבית שלו — האכיפה היא בשרת, לא בקוד האפליקציה.
//
// שלב מעבר: השיוך עבר ממפתח אימייל למפתח מזהה-משתמש. שני המפתחות
// נתמכים במקביל, כי למשתמש שהאתר כבר פתוח אצלו רץ עדיין הקוד הישן
// שקורא לפי אימייל. אחרי שכולם יתרעננו, מוחקים את הנתיב הישן.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function uidDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function emailDoc() {
      return /databases/$(database)/documents/users/$(userEmail());
    }

    // מעדיפים את השיוך לפי מזהה; נופלים לאימייל רק כל עוד המעבר נמשך
    function householdOf() {
      return exists(uidDoc())
        ? get(uidDoc()).data.householdId
        : get(emailDoc()).data.householdId;
    }

    // כל משתמש קורא רק את השיוך של עצמו, בשני המפתחות.
    // כתיבה עדיין חסומה לחלוטין — היא תיפתח בשלב ההרשמה העצמית, ואז
    // תחת תנאים: משפחה חדשה שמזההּ הוא מזהה היוצר, או הזמנה תקפה.
    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || userEmail() == userId);
      allow write: if false;
    }

    // כל נתוני המשפחה: תיעוד התינוקת, הפרופיל שלה, ונתונים ישנים משומרים
    match /households/{householdId}/{document=**} {
      allow read, write: if request.auth != null && householdOf() == householdId;
    }
  }
}
